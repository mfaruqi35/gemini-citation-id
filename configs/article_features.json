{
  "scrape_config": "configs/article_dataset.json",
  "feature_version": "article_features_v2_google_top10",
  "citation_threshold": 0.5,
  "threshold_operator": ">=",
  "credibility_csv": "data/manual/source_credibility.csv",
  "article_review_csv": "data/manual/article_review.csv",
  "bm25_k1": 1.5,
  "bm25_b": 0.75,
  "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
  "embedding_cache": "data/cache/embeddings",
  "embedding_model_cache": "data/cache/models",
  "embedding_chunk_tokens": 112,
  "embedding_chunk_overlap": 16,
  "embedding_aggregation": "mean_normalized_chunks",
  "embedding_threads": 2
}
